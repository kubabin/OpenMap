package dev.kubabin.openmap;

import com.mojang.blaze3d.systems.RenderSystem;
import com.mojang.blaze3d.vertex.*;
import com.mojang.math.Axis;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphics;
import net.minecraft.client.gui.components.StringWidget;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.client.renderer.GameRenderer;
import net.minecraft.client.renderer.ShaderInstance;
import net.minecraft.core.BlockPos;
import net.minecraft.network.chat.Component;
import net.minecraft.util.Mth;
import org.apache.commons.lang3.tuple.Pair;
import org.jetbrains.annotations.NotNull;
import org.joml.Matrix4f;
import org.lwjgl.opengl.GL11;
import org.lwjgl.opengl.GL12;
import org.lwjgl.opengl.GL13;
import org.lwjgl.system.MemoryUtil;

import java.nio.ByteBuffer;

import static dev.kubabin.openmap.Openmap.ClientModEvents.*;

public class OldmapScreen extends Screen {
    private static final int WORLDMAP_TEXTURE_DEPTH = 64;

    private int worldmapTextureId = -1;

    public OldmapScreen(Component title) {
        super(title);
    }

    private int ensureWorldmapTexture() {
        if (worldmapTextureId != -1) {
            return worldmapTextureId;
        }

        worldmapTextureId = GL11.glGenTextures();
        RenderSystem.activeTexture(GL13.GL_TEXTURE0);
        GL11.glBindTexture(GL12.GL_TEXTURE_3D, worldmapTextureId);
        GL11.glTexParameteri(GL12.GL_TEXTURE_3D, GL11.GL_TEXTURE_WRAP_S, GL12.GL_CLAMP_TO_EDGE);
        GL11.glTexParameteri(GL12.GL_TEXTURE_3D, GL11.GL_TEXTURE_WRAP_T, GL12.GL_CLAMP_TO_EDGE);
        GL11.glTexParameteri(GL12.GL_TEXTURE_3D, GL12.GL_TEXTURE_WRAP_R, GL12.GL_CLAMP_TO_EDGE);
        GL11.glTexParameteri(GL12.GL_TEXTURE_3D, GL11.GL_TEXTURE_MIN_FILTER, GL11.GL_NEAREST);
        GL11.glTexParameteri(GL12.GL_TEXTURE_3D, GL11.GL_TEXTURE_MAG_FILTER, GL11.GL_NEAREST);
        GL11.glBindTexture(GL12.GL_TEXTURE_3D, 0);
        return worldmapTextureId;
    }

    private void uploadWorldmapTexture() {
        ByteBuffer textureBuffer = MemoryUtil.memAlloc(TileStorage.REGION_SIZE * TileStorage.REGION_SIZE * WORLDMAP_TEXTURE_DEPTH * 3);
        try {
            for (Pair<Integer, Integer> tile : MinimapThreadManager.tileStorage.availableRegions()) {
                textureBuffer.put(MinimapThreadManager.tileStorage.loadRawRegion(tile.getLeft(), tile.getRight()));
            }
            textureBuffer.flip();

            RenderSystem.activeTexture(GL13.GL_TEXTURE0);
            GL11.glBindTexture(GL12.GL_TEXTURE_3D, ensureWorldmapTexture());
            GL12.glTexImage3D(
                    GL12.GL_TEXTURE_3D,
                    0,
                    GL11.GL_RGB8,
                    TileStorage.REGION_SIZE,
                    TileStorage.REGION_SIZE,
                    WORLDMAP_TEXTURE_DEPTH,
                    0,
                    GL11.GL_RGB,
                    GL11.GL_UNSIGNED_BYTE,
                    textureBuffer
            );
            GL11.glBindTexture(GL12.GL_TEXTURE_3D, 0);
        } finally {
            MemoryUtil.memFree(textureBuffer);
        }
    }

    @Override
    protected void init() {
        super.init();
        Minecraft mc = Minecraft.getInstance();
        BlockPos playerPos = mc.player.blockPosition();
        this.addRenderableOnly(
                new StringWidget(this.width / 2 - 10, this.height - 20,
                        Component.literal("X: " + playerPos.getX() + " Y: " + playerPos.getY() + " Z: " + playerPos.getZ()),
                        Minecraft.getInstance().font)
        );
    }

    @Override
    public void renderBackground(@NotNull GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTick) {
        Minecraft mc = Minecraft.getInstance();
        //guiGraphics.fill(0, 0, 500, 500, 0xFFFF0000);
        RenderSystem.disableDepthTest();
        RenderSystem.depthMask(false);
        RenderSystem.enableBlend();

        ShaderInstance shader = MinimapShaderHandler.getWorldmapShader();
        if (shader != null) {
            RenderSystem.setShader(() -> shader);
            uploadWorldmapTexture();
            RenderSystem.activeTexture(GL13.GL_TEXTURE0);
            GL11.glBindTexture(GL12.GL_TEXTURE_3D, ensureWorldmapTexture());
        }
        if (DynamicTextureManager.readyToUpload){
            DynamicTextureManager.readyToUpload = false;
            DynamicTextureManager.getTexture().upload();
        }
        int guiWidth = guiGraphics.guiWidth();
        int guiHeight = guiGraphics.guiHeight();
        int mapWidth = Math.min(guiWidth, MAP_SIZE);
        int mapHeight = Math.min(guiHeight, MAP_SIZE);
        int mapX = (guiWidth - mapWidth) / 2;
        int mapY = (guiHeight - mapHeight) / 2;
        // Sample the texture shifted by the player's sub-block fraction so the map slides smoothly
        float maxUvX = Math.max(0.0f, Config.mapSize - mapWidth);
        float maxUvY = Math.max(0.0f, Config.mapSize - mapHeight);
        float u = Mth.clamp((float) (mc.player.getX() - lastCenterX) + (CAPTURE_SIZE - MAP_SIZE) / 2.0f, 0, maxUvX);
        float v = Mth.clamp((float) (mc.player.getZ() - lastCenterZ) + (CAPTURE_SIZE - MAP_SIZE) / 2.0f, 0, maxUvY);

        float yaw = mc.player.getViewYRot(partialTick);
        guiWidth = mc.getWindow().getWidth();
        guiHeight= mc.getWindow().getHeight();
        Openmap.LOGGER.info("W: {}, H: {}", guiWidth, guiHeight);

        try {
            BufferBuilder tileBuffer = Tesselator.getInstance().begin(VertexFormat.Mode.QUADS, DefaultVertexFormat.POSITION);
            tileBuffer.addVertex(0,   0,0).setUv(0f,0f);
            tileBuffer.addVertex(0,             TileStorage.REGION_SIZE,0).setUv(0f,1f);
            tileBuffer.addVertex(TileStorage.REGION_SIZE, TileStorage.REGION_SIZE,0).setUv(1f,1f);
            tileBuffer.addVertex(TileStorage.REGION_SIZE, 0,0).setUv(1f,0f);

            try (VertexBuffer vertexBuffer = new VertexBuffer(VertexBuffer.Usage.STATIC)) {
                vertexBuffer.upload(tileBuffer.buildOrThrow());

                if (shader != null) {
                    for (int screenY = 0; screenY < guiHeight; screenY++){
                        for (int screenX = 0; screenX < guiWidth; screenX++){
                            Openmap.LOGGER.info("Drawing tile at {}, {}", screenX, screenY);

                            shader.safeGetUniform("TileOffset").set((float)screenX,(float)screenY);
                            vertexBuffer.drawWithShader(new Matrix4f(), new Matrix4f(), shader);
                            screenX+=512;
                        }
                        screenY+=512;
                    }
                    // Draw the quad manually: GuiGraphics.blit() forces the position_tex_color
                    // shader internally, which would ignore our minimap shader entirely
                    /*Matrix4f mapMatrix = guiGraphics.pose().last().pose();
                    float u0 = u / Config.mapSize;
                    float v0 = v / Config.mapSize;
                    float u1 = (u + mapWidth) / Config.mapSize;
                    float v1 = (v + mapHeight) / Config.mapSize;
                    shader.safeGetUniform("Circular").set(0.0f);
                    shader.safeGetUniform("MaskUvMin").set(u0, v0);
                    shader.safeGetUniform("MaskUvSize").set(u1 - u0, v1 - v0);
                    BufferBuilder mapBuffer = Tesselator.getInstance().begin(VertexFormat.Mode.QUADS, DefaultVertexFormat.POSITION_TEX_COLOR);
                    mapBuffer.addVertex(mapMatrix, mapX, mapY, 0).setUv(u0, v0).setColor(1f, 1f, 1f, 1f);
                    mapBuffer.addVertex(mapMatrix, mapX, mapY + mapHeight, 0).setUv(u0, v1).setColor(1f, 1f, 1f, 1f);
                    mapBuffer.addVertex(mapMatrix, mapX + mapWidth, mapY + mapHeight, 0).setUv(u1, v1).setColor(1f, 1f, 1f, 1f);
                    mapBuffer.addVertex(mapMatrix, mapX + mapWidth, mapY, 0).setUv(u1, v0).setColor(1f, 1f, 1f, 1f);
                    BufferUploader.drawWithShader(mapBuffer.buildOrThrow());*/
                } else {
                    guiGraphics.blit(
                            DynamicTextureManager.DYNAMIC_TEXTURE_LOCATION,
                            mapX, mapY, // XY screen pos
                            mapWidth, mapHeight, // Screen size
                            u, v, // Texture UV offset (sub-pixel)
                            mapWidth, mapHeight, // Texture region size, sampled 1:1
                            Config.mapSize, Config.mapSize // Full texture size
                    );
                }
            }
        } finally {
            GL11.glBindTexture(GL12.GL_TEXTURE_3D, 0);
            VertexBuffer.unbind();
        }

        // Draw player marker in the center, rotated to match the player's yaw
        // (points straight up when the map itself rotates)
        guiGraphics.pose().pushPose();
        guiGraphics.pose().translate(mapX + mapWidth / 2.0, mapY + mapHeight / 2.0, 0);
        guiGraphics.pose().mulPose(Axis.ZP.rotationDegrees(yaw + 180));

        Matrix4f markerMatrix = guiGraphics.pose().last().pose();

        RenderSystem.setShader(GameRenderer::getPositionColorShader);
        BufferBuilder buffer = Tesselator.getInstance().begin(VertexFormat.Mode.TRIANGLES, DefaultVertexFormat.POSITION_COLOR);
        // Black outline
        buffer.addVertex(markerMatrix, 0, -8, 0).setColor(0f, 0f, 0f, 1f);
        buffer.addVertex(markerMatrix, -5.5f, 6.5f, 0).setColor(0f, 0f, 0f, 1f);
        buffer.addVertex(markerMatrix, 5.5f, 6.5f, 0).setColor(0f, 0f, 0f, 1f);
        // White arrow
        buffer.addVertex(markerMatrix, 0, -6, 0).setColor(1f, 1f, 1f, 1f);
        buffer.addVertex(markerMatrix, -4, 5, 0).setColor(1f, 1f, 1f, 1f);
        buffer.addVertex(markerMatrix, 4, 5, 0).setColor(1f, 1f, 1f, 1f);
        BufferUploader.drawWithShader(buffer.buildOrThrow());
        guiGraphics.pose().popPose();

        RenderSystem.setShader(GameRenderer::getPositionTexColorShader);
        RenderSystem.enableDepthTest();
        RenderSystem.depthMask(true);
    }

    @Override
    public void removed() {
        super.removed();
        if (worldmapTextureId != -1) {
            GL11.glBindTexture(GL12.GL_TEXTURE_3D, 0);
            GL11.glDeleteTextures(worldmapTextureId);
            worldmapTextureId = -1;
        }
    }

    @Override
    public void render(@NotNull GuiGraphics guiGraphics, int mouseX, int mouseY, float partialTicks) {
        // Render the map
        this.renderBackground(guiGraphics, mouseX, mouseY, partialTicks);

        Minecraft mc = Minecraft.getInstance();
        if (mc.options.hideGui || mc.player == null || mc.level == null) return;

        super.render(guiGraphics, mouseX, mouseY, partialTicks);
    }
}
